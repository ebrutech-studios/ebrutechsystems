{
  "redirects": [
    {
      "source": "/life",
      "destination": "/life/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "has": [
        {
          "type": "host",
          "value": "life.ebrutechsystems.com"
        }
      ],
      "source": "/",
      "destination": "/life/index.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "life.ebrutechsystems.com"
        }
      ],
      "source": "/:path*",
      "destination": "/life/:path*"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "filotakip.ebrutechsystems.com"
        }
      ],
      "source": "/",
      "destination": "/filo-takip/index.html"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "filotakip.ebrutechsystems.com"
        }
      ],
      "source": "/:path*",
      "destination": "/filo-takip/:path*"
    }
  ]
}
